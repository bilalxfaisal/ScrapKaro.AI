# ==========================================================
# ScrapKaro AI – Backend Environment
# ==========================================================

# Server
PORT=3000

# Gemini (AI research planning / evaluation)
GEMINI_API_KEY=your_gemini_api_key

# Exa (real internet search)
EXA_API_KEY=your_exa_api_key

# Supabase PostgreSQL (Drizzle connection string)
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Supabase Auth
# Project URL from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key — SERVER-SIDE ONLY. Never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
